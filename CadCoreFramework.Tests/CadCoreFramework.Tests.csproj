<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Run the suite on BOTH plugin targets: net48 (AutoCAD 2021–2024) and
      net8.0-windows (AutoCAD 2025+). The tested logic (models, planners, services
      against FakeCadContext, view-models) needs no AutoCAD install on either runtime.
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <!-- WPF: XamlPaletteTests dựng thật các palette để bắt lỗi XAML/resource trước khi vào AutoCAD. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <!--
      x64 như plugin: AutoCAD.NET (net47) chứa AcSeamless.dll AMD64 — test AnyCPU gây MSB3270
      (processor-architecture mismatch), thành lỗi khi build -warnaserror.
    -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit test framework -->
    <PackageReference Include="xunit"                         Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio"     Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"        Version="18.11.0" />

    <!-- Assertion library — reads like English -->
    <PackageReference Include="FluentAssertions"              Version="7.2.2" />

    <!-- Mocking framework — for future integration-style tests -->
    <PackageReference Include="Moq"                           Version="4.21.0" />

    <!-- Shared serialisation library (same version as production) -->
    <PackageReference Include="Newtonsoft.Json"               Version="13.0.4" />

    <!-- Code Coverage — collect coverage data during test run -->
    <PackageReference Include="coverlet.collector"            Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- AutoCAD.NET assemblies for test execution (needed for SelectionFilterBuilder & TypedValue) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET"                   Version="24.0.0" />
    <PackageReference Include="AutoCAD.NET.Core"              Version="24.0.0" />
    <PackageReference Include="AutoCAD.NET.Model"             Version="24.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET"                   Version="25.0.1" />
    <PackageReference Include="AutoCAD.NET.Core"              Version="25.0.0" />
    <PackageReference Include="AutoCAD.NET.Model"             Version="25.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the production project.
         InternalsVisibleTo in AssemblyInfo.cs gives access to internal members. -->
    <ProjectReference Include="..\CadCoreFramework.csproj" />
    <!-- Test doubles: FakeCadContext, FakeCadScope -->
    <ProjectReference Include="..\CadCoreFramework.Testing\CadCoreFramework.Testing.csproj" />
    <!-- AnalyzerTests: tham chiếu analyzer như THƯ VIỆN (không chạy nó trên project test) + Roslyn để biên dịch mẫu. -->
    <ProjectReference Include="..\CadCoreFramework.Analyzers\CadCoreFramework.Analyzers.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.6.0" />
  </ItemGroup>

</Project>

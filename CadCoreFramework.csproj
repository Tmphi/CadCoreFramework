<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-target build:
        net48           → AutoCAD 2021–2024  (.NET Framework 4.8)
        net8.0-windows  → AutoCAD 2025+      (.NET 8.0)
      Switch by selecting the appropriate Configuration/Platform in Visual Studio,
      or pass /p:TargetFramework=net48 to MSBuild explicitly.
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CadCoreFramework</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <!--
      NULLABLE REFERENCE TYPES — MIGRATION MODE
      `annotations` lets us write ? / NotNullWhen() / etc. on our public API
      WITHOUT turning the hundreds of "possibly null" warnings from the
      largely-non-annotated AutoCAD API into noise. Once the codebase is fully
      annotated and the AutoCAD assemblies ship with nullability metadata
      (unlikely before 2027), switch this to `enable` for full flow analysis.
    -->
    <Nullable>annotations</Nullable>

    <!--
      ANALYZER CONFIG
      - EnforceCodeStyleInBuild: run IDExxxx code-style rules as part of `dotnet build`
        (not just inside the IDE). Pairs with .editorconfig severities.
      - AnalysisLevel=latest: pick up new rules automatically when SDK upgrades.
      - AnalysisMode=Recommended: enable Microsoft's curated "worth it" rule set
        for CA* diagnostics. Users can tighten to AllEnabledByDefault later.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!--
      GenerateDocumentationFile: bắt buộc để Roslyn chạy IDE0005 (using thừa) khi build
      (dotnet/roslyn#41640) và để trình biên dịch kiểm tra XML doc (CS1570/CS1573…).
      CS1591 (member public thiếu XML doc) tắt vì template không bắt buộc doc cho mọi member.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      WPF HOT-RELOAD TRICK (Debug only):
      Append a timestamp to the AssemblyName on every Debug build so AutoCAD
      never holds a file lock on the previous DLL. Allows NETLOAD of the new
      DLL without restarting AutoCAD.
      The Post-Build event below copies the timestamped file back to the
      canonical name so other tooling can always find CadCoreFramework.dll.
    -->
    <AssemblyName Condition="'$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true'">CadCoreFramework_$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' != 'Debug' Or '$(DesignTimeBuild)' == 'true'">CadCoreFramework</AssemblyName>

    <!-- Templates\**: file nguồn của `dotnet new cad-command` — không biên dịch vào plugin DLL. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CadCoreFramework.Tests\**;CadCoreFramework.Testing\**;CadCoreFramework.Benchmarks\**;CadCoreFramework.Analyzers\**;Templates\**</DefaultItemExcludes>

    <!--
      MSB3277: benign assembly-conflict warning triggered when dist/ packaging
      artifacts (System.Memory / System.Numerics.Vectors) are present in the
      working tree alongside NuGet copies. MSBuild always chooses the NuGet
      version; the warning is noise rather than a real resolution risk.
    -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- ═══ AutoCAD NuGet References ════════════════════════════════════════════
       ExcludeAssets="runtime" is MANDATORY: AutoCAD ships its own copies of
       AcDbMgd / AcMgd / AcCoreMgd. Copying them to the output directory causes
       DLL version conflicts and Fatal Errors on NETLOAD.
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- AutoCAD 2021–2024: API version 24.x -->
    <PackageReference Include="AutoCAD.NET"       Version="24.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core"  Version="24.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="24.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- AutoCAD 2025+: API version 25.x
         AutoCAD.NET 25.0.1 (không phải 25.0.0): bản 25.0.0 ghim AutoCAD.NET.Core = 25.0.0-V058
         (pre-release) → NU1608. 25.0.1 ghim đúng Core 25.0.0 bên dưới. -->
    <PackageReference Include="AutoCAD.NET"       Version="25.0.1" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core"  Version="25.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="25.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- ═══ Shared Dependencies ══════════════════════════════════════════════ -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"                    Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json"                          Version="13.0.3" />
    <PackageReference Include="Serilog"                                  Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File"                       Version="5.0.0" />
  </ItemGroup>

  <!-- System.IO.Compression is built-in for net8; only needed for net48 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- ═══ Custom Analyzer ═══════════════════════════════════════════════
       CadCoreFramework.Analyzers ships one rule — CAD001 — that forbids
       MdiActiveDocument access inside Services/ViewModels. Referenced as
       an analyzer only (OutputItemType=Analyzer, ReferenceOutputAssembly=false)
       so the analyzer DLL does NOT ship inside CadCoreFramework.dll.
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <ProjectReference Include="CadCoreFramework.Analyzers\CadCoreFramework.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ═══ WPF Hot-Reload Post-Build ══════════════════════════════════════
       Copies the timestamped Debug DLL to the canonical CadCoreFramework.dll
       so that NETLOAD scripts and external tools always find a stable filename.
  ═══════════════════════════════════════════════════════════════════════════ -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent"
          Condition="'$(Configuration)' == 'Debug' And '$(TargetName)' != 'CadCoreFramework'">
    <Exec Command="copy /Y &quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(TargetDir)CadCoreFramework.dll&quot;" />
    <Exec Command="if exist &quot;$(TargetDir)$(TargetName).pdb&quot; copy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)CadCoreFramework.pdb&quot;" />
  </Target>

</Project>
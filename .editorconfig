# ═══════════════════════════════════════════════════════════════════════════════
# CadCoreFramework — EditorConfig
# https://editorconfig.org
# ═══════════════════════════════════════════════════════════════════════════════

root = true

# ─── All files ─────────────────────────────────────────────────────────────────
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# ─── C# files ─────────────────────────────────────────────────────────────────
[*.cs]
# Formatting
csharp_new_line_before_open_brace = all
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true

# Code style
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_prefer_braces = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# Naming conventions
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case
dotnet_naming_style.interface_pascal_case.required_prefix = I

# Private fields: _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

# Interfaces: IPascalCase
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_pascal_case
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface

# Types: PascalCase
dotnet_naming_rule.types.symbols = types
dotnet_naming_rule.types.style = pascal_case
dotnet_naming_rule.types.severity = suggestion
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate

# Async methods must end with Async
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_rule.async_methods_end_in_async.symbols  = async_methods
dotnet_naming_rule.async_methods_end_in_async.style    = pascal_with_async_suffix
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.pascal_with_async_suffix.capitalization = pascal_case
dotnet_naming_style.pascal_with_async_suffix.required_suffix = Async

# ─── Analyzer severity ────────────────────────────────────────────────────────
# CA1416: suppressed globally via SupportedOSPlatform in AssemblyInfo.cs — don't re-flag.
dotnet_diagnostic.CA1416.severity = none
# CA2007: ConfigureAwait(false) — WRONG for AutoCAD (we want the UI SyncContext). Disable.
dotnet_diagnostic.CA2007.severity = none
# CS1591: missing XML doc on public — not every public needs doc. Silence.
dotnet_diagnostic.CS1591.severity = none
# IDE0005: unused usings — surface so dead usings get cleaned.
dotnet_diagnostic.IDE0005.severity = warning
# CA1050: types must be in namespace — enforce, prevents accidental globals.
dotnet_diagnostic.CA1050.severity = warning

# ─── Analyzer tuning (noisy rules in a template context) ─────────────────────
# These rules fire often but either have legitimate CAD-specific exceptions
# or are too opinionated for a general-purpose starter. Users can tighten
# individual rules in their own project's .editorconfig after fork.
dotnet_diagnostic.CA1707.severity = none         # AutoCAD commands use UPPER_SNAKE_CASE
dotnet_diagnostic.CA1822.severity = suggestion   # "can be static" — nice-to-know, not important
dotnet_diagnostic.CA1031.severity = suggestion   # we DO catch Exception in CadCommandBase (policy)
dotnet_diagnostic.CA1051.severity = none         # visible instance fields are fine in DTOs
dotnet_diagnostic.CA1724.severity = suggestion   # types matching ns — stylistic
dotnet_diagnostic.CA1819.severity = suggestion   # array-returning properties — common in AutoCAD data
dotnet_diagnostic.CA2227.severity = none         # settable collections — needed for data binding
dotnet_diagnostic.CA1848.severity = none         # LoggerMessage delegates — we don't use Microsoft.Extensions.Logging
dotnet_diagnostic.CA2254.severity = suggestion   # log message templates — ILoggerService takes plain strings
dotnet_diagnostic.CA1725.severity = none         # parameter name matching — bikeshedding
dotnet_diagnostic.CA1711.severity = none         # suffix rules — too many false positives
dotnet_diagnostic.CA1056.severity = suggestion   # URI vs string — not relevant for file paths
dotnet_diagnostic.CA1054.severity = suggestion   # URI parameters — same
dotnet_diagnostic.CA1304.severity = suggestion   # CultureInfo — fine for Vietnamese UI
dotnet_diagnostic.CA1305.severity = suggestion   # IFormatProvider — same
dotnet_diagnostic.CA1310.severity = suggestion   # StringComparison — same
dotnet_diagnostic.CA1507.severity = suggestion   # nameof — nice-to-have
dotnet_diagnostic.CA2211.severity = none         # non-constant public fields — AppBootstrapper.ServiceProvider pattern
dotnet_diagnostic.CA1816.severity = suggestion   # SuppressFinalize — nice-to-have, not shipping-blocking
dotnet_diagnostic.CA1805.severity = suggestion   # redundant default init — stylistic
dotnet_diagnostic.CA1825.severity = suggestion   # Array.Empty<T>() over new T[0] — minor perf
dotnet_diagnostic.CA1716.severity = none         # VB.NET keyword conflicts — irrelevant for C#-only
dotnet_diagnostic.CA1311.severity = none         # Specify culture for ToUpper — too strict for a template
dotnet_diagnostic.CA1000.severity = none         # Static members on generic types — CadResult<T>.Success is intentional
dotnet_diagnostic.CA1861.severity = suggestion   # Avoid constant arrays — minor perf
dotnet_diagnostic.CA1859.severity = suggestion   # Use concrete types for perf — stylistic
dotnet_diagnostic.CA1854.severity = suggestion   # Prefer TryGetValue — stylistic
dotnet_diagnostic.CA1720.severity = none         # Identifier contains type name — too many false positives
dotnet_diagnostic.CA1510.severity = suggestion   # ArgumentNullException.ThrowIfNull — net48 doesn't have it
dotnet_diagnostic.CA2249.severity = suggestion   # string.Contains(char) — minor perf win
dotnet_diagnostic.CA1866.severity = suggestion   # string method char overloads — minor perf

# Build-time analyzer config messages — not actionable warnings.
dotnet_diagnostic.EnableGenerateDocumentationFile.severity = none

# ─── XAML ──────────────────────────────────────────────────────────────────────
[*.xaml]
indent_size = 4

# ─── XML / Config ─────────────────────────────────────────────────────────────
[*.{xml,config,csproj,props,targets}]
indent_size = 2

# ─── JSON ──────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ─── PowerShell ────────────────────────────────────────────────────────────────
[*.ps1]
indent_size = 4
# BOM BẮT BUỘC: Windows PowerShell 5.1 đọc file không BOM theo ANSI (cp1252) — "—" (E2 80 94)
# chứa byte 0x94 = dấu ngoặc kép cong → chuỗi bị cắt, script lỗi parse.
charset = utf-8-bom

# ─── Markdown ──────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false

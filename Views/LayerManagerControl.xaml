<UserControl x:Class="CadCoreFramework.Views.LayerManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CadCoreFramework.Views"
             xmlns:viewmodels="clr-namespace:CadCoreFramework.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:LayerManagerViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Loaded="UserControl_Loaded">

    <!-- Styles + theme nạp trong code-behind (ThemeManager.Attach) → mọi key màu/style là {DynamicResource}. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BooleanToOnOffConverter x:Key="BooleanToOnOffConverter"/>
        <local:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="10">
            <TextBlock Text="Danh sách Layers" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <!-- Danh sách Layer -->
        <!-- Đặt IsEnabled binding với IsLoading để ngăn click khi đang lấy dữ liệu -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Layers}" AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBooleanConverter}}"
                  Style="{DynamicResource DataGridStyle}" BorderThickness="0">
            <DataGrid.Columns>
                
                <!-- Cột Tên Layer -->
                <DataGridTextColumn Header="Tên Layer" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                
                <!-- Cột Màu sắc -->
                <DataGridTextColumn Header="Màu" Binding="{Binding ColorIndex}" IsReadOnly="True" Width="50" />
                
                <!-- Cột Tắt/Bật -->
                <DataGridTemplateColumn Header="Bật/Tắt" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Sử dụng Command từ ViewModel chính thay vì của Item -->
                            <!-- Truyền đối tượng LayerModel làm CommandParameter -->
                            <Button Content="{Binding IsOn, Converter={StaticResource BooleanToOnOffConverter}}"
                                    Command="{Binding DataContext.ToggleLayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{DynamicResource SecondaryButton}" FontSize="11" Padding="6,2" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading Overlay (Chỉ hiện khi IsLoading = true) -->
        <Border Grid.Row="1" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Đang tải dữ liệu..." Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Nút Refresh -->
        <Button Grid.Row="2" Content="Làm mới" Command="{Binding LoadLayersCommand}" Style="{DynamicResource PrimaryButton}" Margin="10" />
    </Grid>
</UserControl>

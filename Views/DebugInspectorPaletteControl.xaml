<UserControl x:Class="CadCoreFramework.Views.DebugInspectorPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="640"
             Background="#1E1E2E">

    <UserControl.Resources>
        <!-- Minimal design tokens so this palette is self-contained — doesn't
             depend on Themes/Styles.xaml being loaded. -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#7C3AED"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#2A2A3E"/>
        <SolidColorBrush x:Key="SurfaceAltBrush"   Color="#3D3D5C"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#F1F0FF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9693AC"/>
        <SolidColorBrush x:Key="SuccessBrush"      Color="#22C55E"/>
        <SolidColorBrush x:Key="DangerBrush"       Color="#EF4444"/>

        <!-- Shared DataGrid style -->
        <Style x:Key="DebugDataGrid" TargetType="DataGrid">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="RowBackground"   Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#242436"/>
            <Setter Property="BorderBrush"     Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2F2F44"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title + Refresh button -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🔍 Debug Inspector"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Summary}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="↻  Refresh"
                    Command="{Binding RefreshCommand}"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Padding="12,6" Cursor="Hand"
                    FontWeight="SemiBold"/>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource SurfaceAltBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}">

            <!-- Tab 1: Command History -->
            <TabItem Header="Command History" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <DataGrid Style="{StaticResource DebugDataGrid}"
                          ItemsSource="{Binding CommandHistory}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Command"  Binding="{Binding Name}"       Width="2*"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat={}{0:F0} ms}" Width="*"/>
                        <DataGridTextColumn Header="Started"  Binding="{Binding StartedAt}"  Width="*"/>
                        <DataGridTemplateColumn Header="Result" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="{Binding Success, StringFormat='{}{0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Text" Value="✓ OK"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="Text" Value="✗ Fail"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 2: DI Services -->
            <TabItem Header="DI Services" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <DataGrid Style="{StaticResource DebugDataGrid}"
                          ItemsSource="{Binding Services}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Interface / Service" Binding="{Binding ServiceType}" Width="2*"/>
                        <DataGridTextColumn Header="Implementation"      Binding="{Binding ImplementationType}" Width="2*"/>
                        <DataGridTextColumn Header="Lifetime"             Binding="{Binding Lifetime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 3: Event Subscribers -->
            <TabItem Header="Event Subscribers" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListBox ItemsSource="{Binding EventSubscribers}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="Nhấn Refresh để cập nhật dữ liệu mới nhất."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10" Margin="0,8,0,0"/>
    </Grid>
</UserControl>

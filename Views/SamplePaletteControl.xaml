<UserControl x:Class="CadCoreFramework.Views.SamplePaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:CadCoreFramework.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="380"
             Background="#1E1E2E">

    <UserControl.Resources>
        <viewmodels:ViewModelLocator x:Key="Locator"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============================================================
             DESIGN TOKENS — Change these to rebrand for any new tool
             ============================================================ -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#7C3AED"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#2A2A3E"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#F1F0FF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9693AC"/>
        <SolidColorBrush x:Key="DangerBrush"       Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessBrush"      Color="#22C55E"/>

        <!-- Reusable Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Margin"          Value="0,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,8,0,3"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid >
        <!-- IsBusy Overlay — auto shows when ViewModel.IsBusy = true -->
        <Grid Panel.ZIndex="99"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              Background="#AA1E1E2E">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="Đang xử lý..." Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- Header -->
                <TextBlock Text="⚡ CadCore Framework"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Template Palette — Copy và đổi tên để bắt đầu tool mới"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Border Height="1" Background="#3D3D5C" Margin="0,0,0,16"/>

                <!-- Input Section -->
                <TextBlock Text="TÊN THIẾT BỊ" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtDeviceName" Style="{StaticResource InputStyle}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="LAYER" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtLayer" Style="{StaticResource InputStyle}" Text="{Binding LayerName, UpdateSourceTrigger=PropertyChanged}"/>

                <Border Height="1" Background="#3D3D5C" Margin="0,12,0,12"/>

                <!-- Actions -->
                <TextBlock Text="THAO TÁC" Style="{StaticResource LabelStyle}"/>
                <Button x:Name="BtnDrawSample"
                        Content="▶  Vẽ mẫu vào bản vẽ"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding DrawSampleCommand}"/>
                <Button x:Name="BtnClear"
                        Content="🗑  Xóa thông tin"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}"/>

                <!-- Status -->
                <Border Height="1" Background="#3D3D5C" Margin="0,12,0,8"/>
                <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}"
                           Foreground="{Binding StatusColor}" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


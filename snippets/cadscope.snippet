<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>cadscope — ExecuteWithScope block</Title>
      <Shortcut>cadscope</Shortcut>
      <Description>Insert an inline ExecuteWithScope block for use inside an existing command method.</Description>
      <Author>CadCoreFramework</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>UndoMark</ID>
          <Default>Operation</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[ExecuteWithScope(scope =>
{
    $end$
}, undoMarkName: "$UndoMark$");]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
